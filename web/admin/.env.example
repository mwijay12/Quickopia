NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key ONLY ever used server-side (Edge Functions / Next.js server actions) — NEVER in client-side code
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary image hosting (Unsigned upload preset)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Server-side AI Features (Gemini Flash / OpenRouter fallback) - NEVER exposed in client
GEMINI_API_KEY=
OPENROUTER_API_KEY=

