# Quickopia Environment Configuration
# Copy this file to .env or configure in your deployment dashboard

# -------------------------------------------------------------
# 1. Supabase Backend (Database, Auth, Realtime, Storage)
# Get these from your Supabase Dashboard: Project Settings -> API
# -------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -------------------------------------------------------------
# 2. Next.js Web Storefront & Admin (Vercel)
# Public variables exposed to the web client
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-client

# -------------------------------------------------------------
# 3. Media & Image Uploads (Cloudinary Free Tier)
# -------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=quickopia_products

# -------------------------------------------------------------
# 4. AI Features (Gemini API via Supabase Edge Functions)
# -------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# -------------------------------------------------------------
# 5. Local Store & Delivery Configuration (Tanzania)
# -------------------------------------------------------------
DEFAULT_BRANCH_NAME="Quickopia Supermarket - Mlimani Branch"
DEFAULT_CURRENCY="TZS"
WHATSAPP_ORDER_PHONE="+255700000000"
