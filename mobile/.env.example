# ==============================================================================
# Quickopia Mobile - Environment Configuration
# ==============================================================================
# Copy this file to mobile/.env:
#   cp .env.example .env
#
# REQUIRED:
# Public credentials from Supabase Dashboard -> Project Settings -> API.
# Note: Use the publishable key (sb_publishable_*, new) or ANON key (legacy),
# NEVER the service_role / sb_secret_* key.
SUPABASE_URL=https://chajydbbcjdafxaurfyj.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# ==============================================================================
# SECURITY NOTICE - AI PROVIDER KEYS (STAY ON SUPABASE, NEVER HERE)
# ==============================================================================
# In production, AI keys (Groq, Gemini, OpenRouter, ElevenLabs) are deployed
# securely via Supabase Secrets ONLY:
#   supabase secrets set GROQ_KEYS="gsk_...,gsk_..."
#   supabase secrets set GEMINI_KEYS="..."
#   supabase secrets set OPENROUTER_KEYS="..."
#   supabase secrets set ELEVENLABS_KEYS="..."
#
# The mobile app calls the server-side Edge Functions ('ai-assistant', 'ai-tts')
# so provider API keys are NEVER bundled inside the compiled Android APK or iOS IPA.
# APK ni ZIP tu — uki-unzip unaona assets/images na icons pekee, hakuna keys!
#
# DO NOT add GROQ_KEYS / GEMINI_KEYS / OPENROUTER_KEYS / ELEVENLABS_KEYS here.
# mobile/.env holds ONLY public Supabase URL + anon/publishable key (safe for client).
